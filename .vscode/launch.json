{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "agent_sql (asks for Oracle login)",
            "type": "debugpy",
            "request": "launch",
            "module": "agent_sql.agent",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "ORACLE_USER": "${input:oracleUser}",
                "ORACLE_PASSWORD": "${input:oraclePassword}"
            }
        },
        {
            "name": "agent_lg_pdf_search",
            "type": "debugpy",
            "request": "launch",
            "module": "agent_lg_pdf_search.agent",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "oracleUser",
            "type": "promptString",
            "description": "Oracle user",
            "default": "szymon"
        },
        {
            "id": "oraclePassword",
            "type": "promptString",
            "description": "Oracle password",
            "password": true
        }
    ]
}
